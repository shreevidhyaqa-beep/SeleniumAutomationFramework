pipeline {
    agent any

    parameters {
        choice(
            name: 'TEST_SUITE_TYPE',
            choices: ['all', 'smoke', 'sanity', 'regression'],
            description: 'Select the targeted test group suite to execute.'
        )
    }

    stages {
        stage('Checkout Code') {
            steps {
                // Pulls code clean from the attached Git repository
                checkout scm
            }
        }

        stage('Execute Automation') {
            steps {
                script {
                    if (params.TEST_SUITE_TYPE == 'all') {
                        echo "Running Full Automation Regression Suite..."
                        bat "mvn clean test"
                    } else {
                        echo "Running Targeted Group: ${params.TEST_SUITE_TYPE}"
                        // -Dgroups must have an "s" at the end for Surefire to process it
                        bat "mvn clean test -Dgroups=${params.TEST_SUITE_TYPE}"
                    }
                }
            }
        }
    }

    post {
        always {
            // Generates test trend UI charts inside Jenkins automatically
            junit 'target/surefire-reports/*.xml'
        }
    }
}